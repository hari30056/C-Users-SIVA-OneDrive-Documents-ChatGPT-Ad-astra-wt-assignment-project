datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum UserRole {
  ADMIN
  ORGANIZER
  ATTENDEE
}

enum OrganizerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(ATTENDEE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organizer    Organizer?
  reservations Reservation[]
  orders       Order[]

  @@index([email])
  @@index([role])
}

model Organizer {
  id               String          @id @default(uuid())
  organizationName String
  ownerUserId      String          @unique
  status           OrganizerStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  owner            User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  events           Event[]

  @@index([ownerUserId])
  @@index([status])
}

model Event {
  id             String       @id @default(uuid())
  organizerId    String
  title          String
  description    String
  venue          String
  location       String
  category       String       @default("General")
  eventDate      DateTime
  salesStartDate DateTime
  salesCutoffDate DateTime
  status         EventStatus  @default(PUBLISHED)
  imageUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizer      Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTiers    TicketTier[]
  reservations   Reservation[]
  orders         Order[]

  @@index([organizerId])
  @@index([status])
  @@index([eventDate])
}

model TicketTier {
  id                String            @id @default(uuid())
  eventId           String
  name              String
  description       String?
  price             Decimal           @db.Decimal(10, 2)
  totalQuantity     Int
  availableQuantity Int
  reservedQuantity  Int               @default(0)
  soldQuantity      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservationItems  ReservationItem[]
  orderItems        OrderItem[]
  tickets           Ticket[]

  @@index([eventId])
}

model Reservation {
  id          String            @id @default(uuid())
  userId      String
  eventId     String
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items       ReservationItem[]
  order       Order?

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([expiresAt])
}

model ReservationItem {
  id            String      @id @default(uuid())
  reservationId String
  ticketTierId  String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketTier    TicketTier  @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([ticketTierId])
}

model Order {
  id             String               @id @default(uuid())
  userId         String
  eventId        String
  reservationId  String               @unique
  orderNumber    String               @unique
  subtotal       Decimal              @db.Decimal(10, 2)
  totalAmount    Decimal              @db.Decimal(10, 2)
  status         OrderStatus          @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservation    Reservation          @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  transactions   PaymentTransaction[]
  tickets        Ticket[]

  @@index([userId])
  @@index([eventId])
  @@index([reservationId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  ticketTierId String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(10, 2)

  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([ticketTierId])
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  orderId              String
  transactionReference String        @unique
  amount               Decimal       @db.Decimal(10, 2)
  status               PaymentStatus @default(PENDING)
  gatewayResponse      String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionReference])
  @@index([status])
}

model Ticket {
  id           String       @id @default(uuid())
  orderId      String
  ticketTierId String
  ticketCode   String       @unique
  status       TicketStatus @default(ACTIVE)
  issuedAt     DateTime     @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTier   TicketTier   @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([ticketTierId])
  @@index([ticketCode])
}
