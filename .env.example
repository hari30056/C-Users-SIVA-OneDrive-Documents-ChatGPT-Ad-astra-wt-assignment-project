# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_ticketing?schema=public

# Redis Configuration (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Payment Simulation
PAYMENT_SIMULATION_DELAY=2500

# Client & CORS
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000/api
